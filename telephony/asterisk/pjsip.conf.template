; Template: integrare manualmente solo dopo i test Hello World ed Echo.
[transport-tls-openai]
type=transport
protocol=tls
bind=0.0.0.0:5061
method=tlsv1_2
verify_server=yes
ca_list_file=/etc/ssl/certs/ca-certificates.crt
allow_reload=yes

[openai-realtime]
type=endpoint
transport=transport-tls-openai
context=from-openai
disallow=all
allow=opus
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_domain=sip-eu.api.openai.com
aors=openai-realtime

[openai-realtime]
type=aor
contact=sip:sip-eu.api.openai.com:5061;transport=tls
